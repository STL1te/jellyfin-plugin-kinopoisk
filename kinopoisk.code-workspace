{
    "folders": [
        {
            "name": "kinopoisk-plugin",
            "path": "."
        },
        {
            // Optional: a checkout of github.com/jellyfin/jellyfin next to this repository, so that
            // "go to definition" lands in the real provider interfaces instead of decompiled
            // metadata. VS Code just greys this entry out when the folder is not there.
            "name": "jellyfin",
            "path": "../jellyfin"
        }
    ],
    "settings": {
        "dotnet.defaultSolution": "src/Jellyfin.Plugin.Kinopoisk.sln",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
    }
}
