{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/Jellyfin.Plugin.Kinopoisk.sln",
                // Ask dotnet build to generate full paths for file names.
                "-property:GenerateFullPaths=true",
                // Do not generate summary otherwise it leads to duplicate errors in Problems panel
                "-consoleloggerparameters:NoSummary"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/src/Jellyfin.Plugin.Kinopoisk.sln",
                "-property:GenerateFullPaths=true",
                "-consoleloggerparameters:NoSummary"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            // Rewrites GeneratedClient.generated.cs from the live Kinopoisk OpenAPI document.
            // Needs the NSwag Net70 toolchain to start - see AGENTS.md if it refuses to run.
            "label": "regenerate-api-proxy",
            "command": "dotnet",
            "type": "process",
            "args": [
                "msbuild",
                "-target:GenerateApiClientSourceCode",
                "${workspaceFolder}/src/KinopoiskUnofficialInfo.ApiClient/KinopoiskUnofficialInfo.ApiClient.csproj",
                "-property:GenerateFullPaths=true",
                "-consoleloggerparameters:NoSummary"
            ],
            "group": "none",
            "problemMatcher": "$msCompile"
        }
    ]
}
