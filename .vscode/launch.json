{
    // A plugin is a library - there is nothing here to launch. Debugging means attaching to a
    // running Jellyfin server that already has the plugin installed, which needs the server built
    // in Debug and reachable from this machine. See AGENTS.md for the deploy loop.
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
